# Bundles CDrake into single_file/cdrake.cmake, alongside its documentation.
# Usage: cmake -P tools/make_single_file.cmake

cmake_minimum_required( VERSION 3.29 )

cmake_path( SET CDRK_ROOT_DIR NORMALIZE "${CMAKE_CURRENT_LIST_DIR}/.." )
set( CDRK_OUTPUT_FILE "${CDRK_ROOT_DIR}single_file/cdrake.cmake" )

function( _cdrk_inline_file FILE_PATH OUT_CONTENT )
    #
    file( READ "${FILE_PATH}" CONTENT )
    cmake_path( GET FILE_PATH PARENT_PATH FILE_DIR )
    #
    # 1. Drop include guards, the bundle has a single one.
    string( REGEX REPLACE "include_guard\\( GLOBAL \\)\n*" "" CONTENT "${CONTENT}" )
    #
    # 2. Replace each include with the included file, only the first time it is met.
    string( REGEX MATCHALL "include\\( \"[^\"]+\" \\)\n" INCLUDE_LINES "${CONTENT}" )
    foreach( INCLUDE_LINE ${INCLUDE_LINES} )
        #
        string( REGEX REPLACE "include\\( \"([^\"]+)\" \\)\n" "\\1" INCLUDE_PATH "${INCLUDE_LINE}" )
        string( REPLACE "\${CMAKE_CURRENT_LIST_DIR}" "${FILE_DIR}" INCLUDE_PATH "${INCLUDE_PATH}" )
        string( REPLACE "\${CDRK_SCRIPTS_DIR}" "${CDRK_ROOT_DIR}scripts/public" INCLUDE_PATH "${INCLUDE_PATH}" )
        cmake_path( NORMAL_PATH INCLUDE_PATH )
        #
        if( NOT EXISTS "${INCLUDE_PATH}" )
            #
            message( FATAL_ERROR "make_single_file: cannot resolve '${INCLUDE_LINE}' in ${FILE_PATH}!" )
            #
        endif()
        #
        get_property( INLINED_FILES GLOBAL PROPERTY _CDRK_INLINED_FILES )
        if( INCLUDE_PATH IN_LIST INLINED_FILES )
            #
            set( INCLUDED_CONTENT "" )
            #
        else()
            #
            set_property( GLOBAL APPEND PROPERTY _CDRK_INLINED_FILES "${INCLUDE_PATH}" )
            _cdrk_inline_file( "${INCLUDE_PATH}" INCLUDED_CONTENT )
            #
            # Mark where the file starts, as the bundle is otherwise hard to navigate.
            file( RELATIVE_PATH INCLUDE_REL_PATH "${CDRK_ROOT_DIR}" "${INCLUDE_PATH}" )
            set( INCLUDED_CONTENT "#\n# ----------------------------------------\n# ${INCLUDE_REL_PATH}\n# ----------------------------------------\n#\n${INCLUDED_CONTENT}\n" )
            #
        endif()
        #
        string( REPLACE "${INCLUDE_LINE}" "${INCLUDED_CONTENT}" CONTENT "${CONTENT}" )
        #
    endforeach()
    #
    set( ${OUT_CONTENT} "${CONTENT}" PARENT_SCOPE )
    #
endfunction()

# 1. Inline every script reachable from the config file.
_cdrk_inline_file( "${CDRK_ROOT_DIR}CDrakeConfig.cmake" CONTENT )
#
# 2. Replace the config file header, drop the scripts directory and...
string( REGEX REPLACE "^# CDrakeConfig.cmake\n#\n" "" CONTENT "${CONTENT}" )
string( REGEX REPLACE "set\\( CDRK_SCRIPTS_DIR [^\n]*\n" "" CONTENT "${CONTENT}" )
set( HEADER "# cdrake.cmake\n#\n# Single file distribution of CDrake, generated by tools/make_single_file.cmake.\n# Do not edit by hand: change the scripts and regenerate.\n#\n" )
set( CONTENT "${HEADER}${CONTENT}" )
#
# ... restore the single include guard (stripped with the others) and mark the bundle.
string( REGEX REPLACE "(# INCLUDE GUARD\n# =+\n#\n)" "\\1include_guard( GLOBAL )\n" CONTENT "${CONTENT}" )
string( REGEX REPLACE "(set\\( CDRK_REPOSITORY [^\n]*\n)" "\\1set( CDRK_SINGLE_FILE ON )\n" CONTENT "${CONTENT}" )
#
foreach( EXPECTED "include_guard( GLOBAL )" "set( CDRK_SINGLE_FILE ON )" )
    #
    string( FIND "${CONTENT}" "${EXPECTED}" EXPECTED_INDEX )
    if( EXPECTED_INDEX EQUAL -1 )
        #
        message( FATAL_ERROR "make_single_file: could not insert '${EXPECTED}', did CDrakeConfig.cmake change layout?" )
        #
    endif()
    #
endforeach()
#
# 3. Write only if changed.
if( EXISTS "${CDRK_OUTPUT_FILE}" )
    #
    file( READ "${CDRK_OUTPUT_FILE}" OLD_CONTENT )
    #
endif()
if( NOT CONTENT STREQUAL OLD_CONTENT )
    #
    file( WRITE "${CDRK_OUTPUT_FILE}" "${CONTENT}" )
    #
endif()
#
# 4. Copy the documentation next to the bundle.
foreach( DOCUMENTATION_FILE README.md LICENSE )
    #
    file( COPY_FILE "${CDRK_ROOT_DIR}${DOCUMENTATION_FILE}" "${CDRK_ROOT_DIR}single_file/${DOCUMENTATION_FILE}" ONLY_IF_DIFFERENT )
    #
endforeach()
#
message( STATUS "Single file written to: ${CDRK_OUTPUT_FILE}" )
